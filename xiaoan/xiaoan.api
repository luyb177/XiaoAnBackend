syntax = "v1"

info (
	title:   "小安API网关"
	version: "v1.0"
)

// todo 定位
// ---------------------------------------------------------------------------------------------------------------------
// ======================
// ======= model ========
// ======================
// ---------------------------------------------------------------------------------------------------------------------
// auth model 模块
type (
	User {
		userID         uint64 `json:"user_id"`
		name           string `json:"name"`
		email          string `json:"email"`
		avatar         string `json:"avatar"`
		phone          string `json:"phone"`
		department     string `json:"department"`
		role           string `json:"role"`
		classID        uint64 `json:"class_id"`
		status         int64  `json:"status"`
		inviteCodeUsed string `json:"invite_code_used"`
		createdAt      int64  `json:"created_at"`
		updatedAt      int64  `json:"updated_at"`
	}
	UserInfo {
		userID     uint64 `json:"user_id"`
		name       string `json:"name"`
		email      string `json:"email"`
		avatar     string `json:"avatar"`
		phone      string `json:"phone"`
		department string `json:"department"`
		role       string `json:"role"`
		classID    uint64 `json:"class_id"`
		status     int64  `json:"status"`
		createdAt  int64  `json:"created_at"`
		updatedAt  int64  `json:"updated_at"`
	}
	InviteCode {
		code       string `json:"code"`
		creatorID  uint64 `json:"creator_id"`
		department string `json:"department"`
		maxUses    uint64 `json:"max_uses"`
		usedCount  uint64 `json:"used_count"`
		remark     string `json:"remark"`
		expiresAt  int64  `json:"expires_at"`
		targetRole string `json:"target_role"`
		classId    uint64 `json:"class_id"`
		createdAt  int64  `json:"created_at"`
		updatedAt  int64  `json:"updated_at"`
	}
	Class {
		classID          uint64 `json:"class_id"`
		className        string `json:"class_name"`
		classDescription string `json:"class_description"`
		adminID          uint64 `json:"admin_id"`
		studentCount     uint64 `json:"student_count"`
		status           int64  `json:"status"`
		createdAt        int64  `json:"created_at"`
		updatedAt        int64  `json:"updated_at"`
	}
)

// content model 模块
type (
	Article {
		articleID      uint64   `json:"article_id"`
		name           string   `json:"name"`
		tags           []string `json:"tags"`
		url            string   `json:"url"`
		description    string   `json:"description"`
		cover          string   `json:"cover"`
		content        string   `json:"content"`
		author         string   `json:"author"`
		publishedAt    int64    `json:"published_at"`
		createdAt      int64    `json:"created_at"`
		updatedAt      int64    `json:"updated_at"`
		likeCount      uint64   `json:"like_count"`
		viewCount      uint64   `json:"view_count"`
		collectCount   uint64   `json:"collect_count"`
		commentCount   uint64   `json:"comment_count"`
		lastModifiedBy int64    `json:"last_modified_by"`
		relationStatus int64    `json:"relation_status"`
		isLiked        bool     `json:"is_liked"`
		isCollected    bool     `json:"is_collected"`
	}
	Video {
		videoID        uint64   `json:"video_id"`
		name           string   `json:"name"`
		tags           []string `json:"tags"`
		url            string   `json:"url"`
		description    string   `json:"description"`
		cover          string   `json:"cover"`
		author         string   `json:"author"`
		publishedAt    int64    `json:"published_at"`
		createdAt      int64    `json:"created_at"`
		updatedAt      int64    `json:"updated_at"`
		likeCount      uint64   `json:"like_count"`
		viewCount      uint64   `json:"view_count"`
		collectCount   uint64   `json:"collect_count"`
		commentCount   uint64   `json:"comment_count"`
		lastModifiedBy int64    `json:"last_modified_by"`
		relationStatus int64    `json:"relation_status"`
		isLiked        bool     `json:"is_liked"`
		isCollected    bool     `json:"is_collected"`
	}
	Podcast {
		podcastID      uint64                 `json:"podcast_id"`
		name           string                 `json:"name"`
		tags           []string               `json:"tags"`
		url            string                 `json:"url"`
		description    string                 `json:"description"`
		cover          string                 `json:"cover"`
		author         string                 `json:"author"`
		channel        string                 `json:"channel"`
		status         int64                  `json:"status"`
		publishedAt    int64                  `json:"published_at"`
		createdAt      int64                  `json:"created_at"`
		updatedAt      int64                  `json:"updated_at"`
		likeCount      uint64                 `json:"like_count"`
		viewCount      uint64                 `json:"view_count"`
		collectCount   uint64                 `json:"collect_count"`
		commentCount   uint64                 `json:"comment_count"`
		highlights     []PodcastHighlightItem `json:"highlights"`
		lastModifiedBy int64                  `json:"last_modified_by"`
		relationStatus int64                  `json:"relation_status"`
		isLiked        bool                   `json:"is_liked"`
		isCollected    bool                   `json:"is_collected"`
	}
	PodcastHighlightItem {
		second    uint64 `json:"second"`
		highlight string `json:"highlight"`
	}
	Comic {
		comicID        uint64   `json:"comic_id"`
		name           string   `json:"name"`
		tags           []string `json:"tags"`
		description    string   `json:"description"`
		cover          string   `json:"cover"`
		author         string   `json:"author"`
		publishedAt    int64    `json:"published_at"`
		createdAt      int64    `json:"created_at"`
		updatedAt      int64    `json:"updated_at"`
		likeCount      uint64   `json:"like_count"`
		viewCount      uint64   `json:"view_count"`
		collectCount   uint64   `json:"collect_count"`
		commentCount   uint64   `json:"comment_count"`
		chapterCount   uint64   `json:"chapter_count"`
		lastModifiedBy int64    `json:"last_modified_by"`
		relationStatus int64    `json:"relation_status"`
		isLiked        bool     `json:"is_liked"`
		isCollected    bool     `json:"is_collected"`
	}
	ComicChapter {
		comicChapterID uint64 `json:"comic_chapter_id"`
		comicID        uint64 `json:"comic_id"`
		chapterNo      int64  `json:"chapter_no"`
		title          string `json:"title"`
		description    string `json:"description"`
		status         int64  `json:"status"`
		pageCount      uint64 `json:"page_count"`
		publishedAt    int64  `json:"published_at"`
		createdAt      int64  `json:"created_at"`
		updatedAt      int64  `json:"updated_at"`
	}
	ComicChapterPage {
		comicChapterPageID uint64 `json:"comic_chapter_page_id"`
		comicChapterID     uint64 `json:"comic_chapter_id"`
		pageNo             int64  `json:"page_no"`
		pageURL            string `json:"page_url"`
		createdAt          int64  `json:"created_at"`
		updatedAt          int64  `json:"updated_at"`
	}
	Comment {
		commentID      uint64 `json:"comment_id"`
		contentType    string `json:"content_type"`
		contentID      uint64 `json:"content_id"`
		userID         uint64 `json:"user_id"`
		nickname       string `json:"nickname"`
		avatar         string `json:"avatar"`
		ipLocation     string `json:"ip_location"`
		parentID       uint64 `json:"parent_id"`
		replyCommentID uint64 `json:"reply_comment_id"`
		replyUserID    uint64 `json:"reply_user_id"`
		commentText    string `json:"comment_text"`
		likeCount      uint64 `json:"like_count"`
		status         uint64 `json:"status"`
		createdAt      int64  `json:"created_at"`
		updatedAt      int64  `json:"updated_at"`
		isLiked        bool   `json:"is_liked"`
	}
)

// todo 定位
// ---------------------------------------------------------------------------------------------------------------------
// =================
// ==== Request ====
// =================
// ---------------------------------------------------------------------------------------------------------------------
// auth 模块
type (
	SendEmailRequest {
		email string `json:"email"`
	}
	ValidateEmailRequest {
		email string `json:"email"`
		code  string `json:"code"`
	}
	GenerateInviteCodeRequest {
		department string `json:"department"`
		maxUses    uint64 `json:"max_uses"`
		remark     string `json:"remark"`
		expiresAt  int64  `json:"expires_at"`
		targetRole string `json:"target_role"`
		classId    uint64 `json:"class_id"`
	}
	GetInviteCodeRequest {
		pageSize int64  `form:"page_size"`
		cursor   uint64 `form:"cursor"`
		userID   uint64 `form:"user_id"`
	}
	RegisterRequest {
		email          string `json:"email"`
		emailCode      string `json:"email_code"`
		password       string `json:"password"`
		inviteCodeUsed string `json:"invite_code_used"`
	}
	LoginRequest {
		tp        string `json:"type"`
		email     string `json:"email"`
		password  string `json:"password,optional"`
		emailCode string `json:"email_code,optional"`
	}
	ModifyUserBaseInfoRequest {
		name   string `json:"name"`
		avatar string `json:"avatar"`
		phone  string `json:"phone"`
		userID uint64 `json:"user_id"`
	}
	GetUserInfoRequest {
		userID uint64 `form:"user_id"`
	}
	GenerateClassRequest {
		className        string `json:"class_name"`
		classDescription string `json:"class_description"`
	}
	GetClassesRequest {
		pageSize int64  `form:"page_size"`
		cursor   uint64 `form:"cursor"`
		userID   uint64 `form:"user_id"`
	}
	GetClassInfoRequest {
		classID uint64 `form:"class_id"`
	}
	ChangeClassRequest {
		inviteCode string `json:"invite_code"`
	}
	InvalidateInviteCodeRequest {
		code string `json:"code"`
	}
)

// qa 模块
type (
	GetAnswerRequest {
		question string `json:"question"`
	}
)

// content 模块
type (
	// 文章
	AddArticleRequest {
		name        string   `json:"name"`
		description string   `json:"description"`
		content     string   `json:"content"`
		cover       string   `json:"cover"`
		url         string   `json:"url"`
		publishedAt int64    `json:"published_at"`
		author      string   `json:"author"`
		tags        []string `json:"tags"`
	}
	GetArticleContentRequest {
		articleId uint64 `form:"article_id"`
	}
	ModifyArticleRequest {
		articleId   uint64   `json:"article_id"`
		name        string   `json:"name"`
		description string   `json:"description"`
		content     string   `json:"content"`
		cover       string   `json:"cover"`
		url         string   `json:"url"`
		publishedAt int64    `json:"published_at"`
		author      string   `json:"author"`
		tags        []string `json:"tags"`
	}
	DeleteArticleRequest {
		articleId uint64 `form:"article_id"`
	}
	// 视频
	AddVideoRequest {
		name        string   `json:"name"`
		url         string   `json:"url"`
		description string   `json:"description"`
		cover       string   `json:"cover"`
		author      string   `json:"author"`
		publishedAt int64    `json:"published_at"`
		tags        []string `json:"tags"`
	}
	GetVideoContentRequest {
		videoID uint64 `form:"video_id"`
	}
	ModifyVideoRequest {
		videoID     uint64   `json:"video_id"`
		name        string   `json:"name"`
		url         string   `json:"url"`
		description string   `json:"description"`
		cover       string   `json:"cover"`
		author      string   `json:"author"`
		publishedAt int64    `json:"published_at"`
		tags        []string `json:"tags"`
	}
	DeleteVideoRequest {
		videoID uint64 `form:"video_id"`
	}
	// 播客
	AddPodcastRequest {
		name        string                  `json:"name"`
		url         string                  `json:"url"`
		description string                  `json:"description"`
		cover       string                  `json:"cover"`
		author      string                  `json:"author"`
		publishedAt int64                   `json:"published_at"`
		channel     string                  `json:"channel"`
		status      int64                   `json:"status"`
		tags        []string                `json:"tags"`
		highlights  []*PodcastHighlightItem `json:"highlights"`
	}
	GetPodcastContentRequest {
		podcastID uint64 `form:"podcast_id"`
	}
	ModifyPodcastRequest {
		podcastID   uint64                  `json:"podcast_id"`
		name        string                  `json:"name"`
		url         string                  `json:"url"`
		description string                  `json:"description"`
		cover       string                  `json:"cover"`
		author      string                  `json:"author"`
		publishedAt int64                   `json:"published_at"`
		channel     string                  `json:"channel"`
		status      int64                   `json:"status"`
		tags        []string                `json:"tags"`
		highlights  []*PodcastHighlightItem `json:"highlights"`
	}
	DeletePodcastRequest {
		podcastID uint64 `form:"podcast_id"`
	}
	// 漫画
	AddComicRequest {
		name        string   `json:"name"`
		tags        []string `json:"tags"`
		description string   `json:"description"`
		cover       string   `json:"cover"`
		author      string   `json:"author"`
		publishedAt int64    `json:"published_at"`
	}
	AddComicChapterRequest {
		comicID     uint64   `json:"comic_id"`
		chapterNo   int64    `json:"chapter_no"`
		title       string   `json:"title"`
		description string   `json:"description"`
		status      int64    `json:"status"`
		publishedAt int64    `json:"published_at"`
		pageUrls    []string `json:"page_urls"`
	}
	GetComicRequest {
		comicID uint64 `form:"comic_id"`
	}
	GetComicChapterRequest {
		comicID  uint64 `form:"comic_id"`
		page     int64  `form:"page"`
		pageSize int64  `form:"page_size"`
	}
	GetComicPageRequest {
		comicChapterId uint64 `form:"comic_chapter_id"`
		page           int64  `form:"page"`
		pageSize       int64  `form:"page_size"`
	}
	ModifyComicRequest {
		comicID     uint64   `json:"comic_id"`
		name        string   `json:"name"`
		tags        []string `json:"tags"`
		description string   `json:"description"`
		cover       string   `json:"cover"`
		author      string   `json:"author"`
		publishedAt int64    `json:"published_at"`
	}
	ModifyComicChapterRequest {
		comicChapterId uint64   `json:"comic_chapter_id"`
		comicID        uint64   `json:"comic_id"`
		chapterNo      int64    `json:"chapter_no"`
		title          string   `json:"title"`
		description    string   `json:"description"`
		status         int64    `json:"status"`
		publishedAt    int64    `json:"published_at"`
		pageUrls       []string `json:"page_urls"`
	}
	DeleteComicRequest {
		comicID uint64 `form:"comic_id"`
	}
	DeleteComicChapterRequest {
		comicChapterId uint64 `form:"comic_chapter_id"`
		comicID        uint64 `form:"comic_id"`
	}
	AddCommentRequest {
		contentType    string `json:"content_type"`
		contentId      uint64 `json:"content_id"`
		userName       string `json:"user_name"`
		avatar         string `json:"avatar"`
		parentId       uint64 `json:"parent_id"`
		replyCommentId uint64 `json:"reply_comment_id"`
		replyUserId    uint64 `json:"reply_user_id"`
		commentText    string `json:"comment_text"`
		status         uint64 `json:"status"`
	}
	DeleteCommentRequest {
		commentID uint64 `form:"comment_id"`
	}
	GetRootCommentRequest {
		contentType string `form:"content_type"`
		contentId   uint64 `form:"content_id"`
		page        int64  `form:"page"`
		pageSize    int64  `form:"page_size"`
	}
	GetSubCommentRequest {
		contentType     string `form:"content_type"`
		contentId       uint64 `form:"content_id"`
		parentCommentId uint64 `form:"parent_comment_id"`
		page            int64  `form:"page"`
		pageSize        int64  `form:"page_size"`
	}
	LikeRequest {
		contentType string `json:"content_type"`
		contentId   uint64 `json:"content_id"`
	}
	UnlikeRequest {
		contentType string `json:"content_type"`
		contentId   uint64 `json:"content_id"`
	}
	CollectRequest {
		contentType string `json:"content_type"`
		contentId   uint64 `json:"content_id"`
	}
	UnCollectRequest {
		contentType string `json:"content_type"`
		contentId   uint64 `json:"content_id"`
	}
)

// todo 定位
// ---------------------------------------------------------------------------------------------------------------------
// ==================
// ==== Response ====
// ==================
// ---------------------------------------------------------------------------------------------------------------------
// 问答返回模块
type (
	GetAnswerResponse {
		answer string `json:"answer"`
	}
)

// auth 返回模块
type (
	LoginResponse {
		token string `json:"token"`
		user  User   `json:"user"`
	}
	RegisterResponse {
		user User `json:"user"`
	}
	GenerateInviteCodeResponse {
		inviteCode InviteCode `json:"invite_code"`
	}
	GetInviteCodeResponse {
		inviteCodes []InviteCode `json:"invite_codes"`
		hasMore     bool         `json:"has_more"`
		nextCursor  uint64       `json:"next_cursor"`
	}
	GetUserInfoResponse {
		userInfo UserInfo `json:"user_info"`
	}
	GetClassesResponse {
		classes    []Class `json:"classes"`
		hasMore    bool    `json:"has_more"`
		nextCursor uint64  `json:"next_cursor"`
	}
	GetClassInfoResponse {
		classInfo Class `json:"class_info"`
	}
)

// content 返回模块
type (
	AddArticleResponse {
		articleId      uint64 `json:"article_id"`
		relationStatus int64  `json:"relation_status"`
	}
	ModifyArticleResponse {
		articleId      uint64 `json:"article_id"`
		relationStatus int64  `json:"relation_status"`
	}
	GetArticleResponse {
		article Article `json:"article"`
	}
	AddVideoResponse {
		videoID        uint64 `json:"video_id"`
		relationStatus int64  `json:"relation_status"`
	}
	ModifyVideoResponse {
		videoID        uint64 `json:"video_id"`
		relationStatus int64  `json:"relation_status"`
	}
	GetVideoResponse {
		video Video `json:"video"`
	}
	AddPodcastResponse {
		podcastID      uint64 `json:"podcast_id"`
		relationStatus int64  `json:"relation_status"`
	}
	GetPodcastResponse {
		podcast Podcast `json:"podcast"`
	}
	ModifyPodcastResponse {
		podcastID      uint64 `json:"podcast_id"`
		relationStatus int64  `json:"relation_status"`
	}
	AddComicResponse {
		comicID        uint64 `json:"comic_id"`
		relationStatus int64  `json:"relation_status"`
	}
	AddComicChapterResponse {
		comicChapterId uint64 `json:"comic_chapter_id"`
		relationStatus int64  `json:"relation_status"`
	}
	GetComicResponse {
		comic Comic `json:"comic"`
	}
	GetComicChapterResponse {
		chapters []ComicChapter `json:"chapters"`
	}
	GetComicChapterPageResponse {
		pages []ComicChapterPage `json:"pages"`
	}
	ModifyComicResponse {
		comicID        uint64 `json:"comic_id"`
		relationStatus int64  `json:"relation_status"`
	}
	ModifyComicChapterResponse {
		comicChapterId uint64 `json:"comic_chapter_id"`
		relationStatus int64  `json:"relation_status"`
	}
	AddCommentResponse {
		commentID      uint64 `json:"comment_id"`
		relationStatus int64  `json:"relation_status"`
	}
	GetRootCommentResponse {
		comments []Comment `json:"comments"`
	}
	GetSubCommentResponse {
		comments []Comment `json:"comments"`
	}
)

// 通用返回结构
type (
	Response {
		code    int64       `json:"code"`
		message string      `json:"message"`
		data    interface{} `json:"data"`
	}
	EmptyResponse  {}
)

// todo 定位
// ---------------------------------------------------------------------------------------------------------------------
// ======================
// ======== auth ========
// ======================
// ---------------------------------------------------------------------------------------------------------------------
@server (
	prefix:     /api/auth
	tags:       "认证模块"
	group:      auth
	middleware: IPMiddleware
)
service xiaoan {
	@doc "发送邮箱验证码"
	@handler SendEmail
	post /send-email (SendEmailRequest) returns (Response)

	@doc "注册"
	@handler Register
	post /register (RegisterRequest) returns (Response)

	@doc "登录"
	@handler Login
	post /login (LoginRequest) returns (Response)
}

@server (
	prefix:     /api/auth
	tags:       "认证模块"
	group:      auth
	middleware: AuthMiddleware,IPMiddleware
)
service xiaoan {
	@doc "生成邀请码"
	@handler GenerateInviteCode
	post /generate-invite-code (GenerateInviteCodeRequest) returns (Response)

	@doc "获取邀请码"
	@handler GetInviteCode
	get /get-invite-code (GetInviteCodeRequest) returns (Response)

	@doc "修改用户基本信息"
	@handler ModifyUserBaseInfo
	post /modify-user-base-info (ModifyUserBaseInfoRequest) returns (Response)

	@doc "获取用户信息"
	@handler GetUserInfo
	get /get-user-info (GetUserInfoRequest) returns (Response)

	@doc "生成班级"
	@handler GenerateClass
	post /generate-class (GenerateClassRequest) returns (Response)

	@doc "获取班级列表"
	@handler GetClasses
	get /get-classes (GetClassesRequest) returns (Response)

	@doc "获取班级信息"
	@handler GetClassInfo
	get /get-class-info (GetClassInfoRequest) returns (Response)

	@doc "切换班级"
	@handler ChangeClass
	post /change-class (ChangeClassRequest) returns (Response)

	@doc "失效邀请码"
	@handler InvalidateInviteCode
	post /invalidate-invite-code (InvalidateInviteCodeRequest) returns (Response)
}

// todo 定位
// ---------------------------------------------------------------------------------------------------------------------
// ======================
// ========= qa =========
// ======================
// ---------------------------------------------------------------------------------------------------------------------
@server (
	prefix:     /api/qa
	tags:       "问答模块"
	group:      qa
	middleware: IPMiddleware
)
service xiaoan {
	@doc "获取答案"
	@handler GetAnswer
	post /answer (GetAnswerRequest) returns (Response)
}

// todo 定位
// ---------------------------------------------------------------------------------------------------------------------
// ======================
// ======= content ======
// ======================
// ---------------------------------------------------------------------------------------------------------------------
@server (
	prefix:     /api/content
	tags:       "文件内容模块"
	group:      content
	middleware: AuthMiddleware,IPMiddleware
)
service xiaoan {
	@doc "添加文章"
	@handler AddArticle
	post /add-article (AddArticleRequest) returns (Response)

	@doc "修改文章"
	@handler ModifyArticle
	post /modify-article (ModifyArticleRequest) returns (Response)

	@doc "删除文章"
	@handler DeleteArticle
	delete /delete-article (DeleteArticleRequest) returns (Response)

	@doc "获取文章详细内容"
	@handler GetArticleContent
	get /get-article-content (GetArticleContentRequest) returns (Response)

	@doc "添加视频"
	@handler AddVideo
	post /add-video (AddVideoRequest) returns (Response)

	@doc "修改视频"
	@handler ModifyVideo
	post /modify-video (ModifyVideoRequest) returns (Response)

	@doc "删除视频"
	@handler DeleteVideo
	delete /delete-video (DeleteVideoRequest) returns (Response)

	@doc "获取视频详细内容"
	@handler GetVideoContent
	get /get-video-content (GetVideoContentRequest) returns (Response)

	@doc "添加播客"
	@handler AddPodcast
	post /add-podcast (AddPodcastRequest) returns (Response)

	@doc "修改播客"
	@handler ModifyPodcast
	post /modify-podcast (ModifyPodcastRequest) returns (Response)

	@doc "删除播客"
	@handler DeletePodcast
	delete /delete-podcast (DeletePodcastRequest) returns (Response)

	@doc "获取播客详细内容"
	@handler GetPodcastContent
	get /get-podcast-content (GetPodcastContentRequest) returns (Response)

	@doc "添加漫画"
	@handler AddComic
	post /add-comic (AddComicRequest) returns (Response)

	@doc "添加漫画章节"
	@handler AddComicChapter
	post /add-comic-chapter (AddComicChapterRequest) returns (Response)

	@doc "修改漫画"
	@handler ModifyComic
	post /modify-comic (ModifyComicRequest) returns (Response)

	@doc "修改漫画章节"
	@handler ModifyComicChapter
	post /modify-comic-chapter (ModifyComicChapterRequest) returns (Response)

	@doc "删除漫画"
	@handler DeleteComic
	delete /delete-comic (DeleteComicRequest) returns (Response)

	@doc "删除漫画章节"
	@handler DeleteComicChapter
	delete /delete-comic-chapter (DeleteComicChapterRequest) returns (Response)

	@doc "获取漫画"
	@handler GetComic
	get /get-comic (GetComicRequest) returns (Response)

	@doc "获取漫画章节"
	@handler GetComicChapter
	get /get-comic-chapter (GetComicChapterRequest) returns (Response)

	@doc "获取漫画页面"
	@handler GetComicPage
	get /get-comic-page (GetComicPageRequest) returns (Response)

	@doc "添加评论"
	@handler AddComment
	post /add-comment (AddCommentRequest) returns (Response)

	@doc "删除评论"
	@handler DeleteComment
	delete /delete-comment (DeleteCommentRequest) returns (Response)

	@doc "获取根评论"
	@handler GetRootComment
	get /get-root-comment (GetRootCommentRequest) returns (Response)

	@doc "获取子评论"
	@handler GetSubComment
	get /get-sub-comment (GetSubCommentRequest) returns (Response)

	@doc "点赞"
	@handler Like
	post /like (LikeRequest) returns (Response)

	@doc "取消点赞"
	@handler Unlike
	post /unlike (UnlikeRequest) returns (Response)

	@doc "收藏"
	@handler Collect
	post /collect (CollectRequest) returns (Response)

	@doc "取消收藏"
	@handler UnCollect
	post /uncollect (UnCollectRequest) returns (Response)
}

