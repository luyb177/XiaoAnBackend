syntax = "v1"

info (
	title:   "小安API网关"
	version: "v1.0"
)

// ---------------------------------------------------------------------------------------------------------------------
// =================
// ==== Request ====
// =================
// ---------------------------------------------------------------------------------------------------------------------
// auth 模块
type (
	SendEmailRequest {
		email string `json:"email"`
	}
	ValidateEmailRequest {
		email string `json:"email"`
		code  string `json:"code"`
	}
	GenerateInviteCodeRequest {
		creator_name string `json:"creator_name"`
		department   string `json:"department"`
		maxUses      int64  `json:"max_uses"`
		remark       string `json:"remark"`
		expires_at   int64  `json:"expires_at"`
		target_role  string `json:"target_role"`
		classId      uint64 `json:"class_id"`
	}
	GetInviteCodeRequest {
		page     int64 `json:"page"`
		pageSize int64 `json:"page_size"`
	}
	RegisterRequest {
		email          string `json:"email"`
		emailCode      string `json:"email_code"`
		password       string `json:"password"`
		inviteCodeUsed string `json:"invite_code_used"`
	}
	LoginRequest {
		tp        string `json:"type"`
		email     string `json:"email"`
		password  string `json:"password,optional"`
		emailCode string `json:"email_code,optional"`
	}
)

// qa 模块
type (
	GetAnswerRequest {
		question string `json:"question"`
	}
)

// content 模块
type (
	// 文章
	AddArticleRequest {
		name        string   `json:"name"`
		description string   `json:"description"`
		content     string   `json:"content"`
		cover       string   `json:"cover"`
		url         string   `json:"url"`
		publishedAt int64    `json:"published_at"`
		author      string   `json:"author"`
		tags        []string `json:"tags"`
	}
	GetArticleContentRequest {
		articleId uint64 `form:"article_id"`
	}
	ModifyArticleRequest {
		articleId   uint64   `json:"article_id"`
		name        string   `json:"name"`
		description string   `json:"description"`
		content     string   `json:"content"`
		cover       string   `json:"cover"`
		url         string   `json:"url"`
		publishedAt int64    `json:"published_at"`
		author      string   `json:"author"`
		tags        []string `json:"tags"`
	}
	DeleteArticleRequest {
		articleId uint64 `form:"article_id"`
	}
	// 视频
	AddVideoRequest {
		name        string   `json:"name"`
		url         string   `json:"url"`
		description string   `json:"description"`
		cover       string   `json:"cover"`
		author      string   `json:"author"`
		publishedAt int64    `json:"published_at"`
		tags        []string `json:"tags"`
	}
	GetVideoContentRequest {
		videoId uint64 `form:"video_id"`
	}
	ModifyVideoRequest {
		videoId     uint64   `json:"video_id"`
		name        string   `json:"name"`
		url         string   `json:"url"`
		description string   `json:"description"`
		cover       string   `json:"cover"`
		author      string   `json:"author"`
		publishedAt int64    `json:"published_at"`
		tags        []string `json:"tags"`
	}
	DeleteVideoRequest {
		videoId uint64 `form:"video_id"`
	}
	// 播客
	AddPodcastRequest {
		name        string                  `json:"name"`
		url         string                  `json:"url"`
		description string                  `json:"description"`
		cover       string                  `json:"cover"`
		author      string                  `json:"author"`
		publishedAt int64                   `json:"published_at"`
		channel     string                  `json:"channel"`
		status      int64                   `json:"status"`
		tags        []string                `json:"tags"`
		highlights  []*PodcastHighlightItem `json:"highlights"`
	}
	PodcastHighlightItem {
		second    uint64 `json:"second"`
		highlight string `json:"highlight"`
	}
	GetPodcastContentRequest {
		podcastId uint64 `form:"podcast_id"`
	}
	ModifyPodcastRequest {
		podcastId   uint64                  `json:"podcast_id"`
		name        string                  `json:"name"`
		url         string                  `json:"url"`
		description string                  `json:"description"`
		cover       string                  `json:"cover"`
		author      string                  `json:"author"`
		publishedAt int64                   `json:"published_at"`
		channel     string                  `json:"channel"`
		status      int64                   `json:"status"`
		tags        []string                `json:"tags"`
		highlights  []*PodcastHighlightItem `json:"highlights"`
	}
	DeletePodcastRequest {
		podcastId uint64 `form:"podcast_id"`
	}
	// 漫画
	AddComicRequest {
		name        string   `json:"name"`
		tags        []string `json:"tags"`
		description string   `json:"description"`
		cover       string   `json:"cover"`
		author      string   `json:"author"`
		publishedAt int64    `json:"published_at"`
	}
	AddComicChapterRequest {
		comicId     uint64   `json:"comic_id"`
		chapterNo   int64    `json:"chapter_no"`
		title       string   `json:"title"`
		description string   `json:"description"`
		status      int64    `json:"status"`
		publishedAt int64    `json:"published_at"`
		pageUrls    []string `json:"page_urls"`
	}
	GetComicRequest {
		comicId uint64 `form:"comic_id"`
	}
	GetComicChapterRequest {
		comicId  uint64 `form:"comic_id"`
		page     int64  `form:"page"`
		pageSize int64  `form:"page_size"`
	}
	GetComicPageRequest {
		comicChapterId uint64 `form:"comic_chapter_id"`
		page           int64  `form:"page"`
		pageSize       int64  `form:"page_size"`
	}
	ModifyComicRequest {
		comicId     uint64   `json:"comic_id"`
		name        string   `json:"name"`
		tags        []string `json:"tags"`
		description string   `json:"description"`
		cover       string   `json:"cover"`
		author      string   `json:"author"`
		publishedAt int64    `json:"published_at"`
	}
	ModifyComicChapterRequest {
		comicChapterId uint64   `json:"comic_chapter_id"`
		comicId        uint64   `json:"comic_id"`
		chapterNo      int64    `json:"chapter_no"`
		title          string   `json:"title"`
		description    string   `json:"description"`
		status         int64    `json:"status"`
		publishedAt    int64    `json:"published_at"`
		pageUrls       []string `json:"page_urls"`
	}
	DeleteComicRequest {
		comicId uint64 `form:"comic_id"`
	}
	DeleteComicChapterRequest {
		comicChapterId uint64 `form:"comic_chapter_id"`
		comicId        uint64 `form:"comic_id"`
	}
	AddCommentRequest {
		contentType    string `json:"content_type"`
		contentId      uint64 `json:"content_id"`
		userName       string `json:"user_name"`
		avatar         string `json:"avatar"`
		parentId       uint64 `json:"parent_id"`
		replyCommentId uint64 `json:"reply_comment_id"`
		replyUserId    uint64 `json:"reply_user_id"`
		commentText    string `json:"comment_text"`
		status         uint64 `json:"status"`
	}
	DeleteCommentRequest {
		commentId uint64 `form:"comment_id"`
	}
	GetRootCommentRequest {
		contentType string `form:"content_type"`
		contentId   uint64 `form:"content_id"`
		page        int64  `form:"page"`
		pageSize    int64  `form:"page_size"`
	}
	GetSubCommentRequest {
		contentType     string `form:"content_type"`
		contentId       uint64 `form:"content_id"`
		parentCommentId uint64 `form:"parent_comment_id"`
		page            int64  `form:"page"`
		pageSize        int64  `form:"page_size"`
	}
	LikeRequest {
		contentType string `json:"content_type"`
		contentId   uint64 `json:"content_id"`
	}
	UnlikeRequest {
		contentType string `json:"content_type"`
		contentId   uint64 `json:"content_id"`
	}
	CollectRequest {
		contentType string `json:"content_type"`
		contentId   uint64 `json:"content_id"`
	}
	UnCollectRequest {
		contentType string `json:"content_type"`
		contentId   uint64 `json:"content_id"`
	}
)

// ---------------------------------------------------------------------------------------------------------------------
// ==================
// ==== Response ====
// ==================
// ---------------------------------------------------------------------------------------------------------------------
// 问答返回模块
type (
	GetAnswerResponse {
		answer string `json:"answer"`
	}
)

// 通用返回结构
type (
	Response {
		code    int64       `json:"code"`
		message string      `json:"message"`
		data    interface{} `json:"data"`
	}
)

// ---------------------------------------------------------------------------------------------------------------------
// ======================
// ======== auth ========
// ======================
// ---------------------------------------------------------------------------------------------------------------------
@server (
	prefix:     /api/auth
	tags:       "认证模块"
	group:      auth
	middleware: IPMiddleware
)
service xiaoan {
	@doc "发送邮箱验证码"
	@handler SendEmail
	post /send-email (SendEmailRequest) returns (Response)

	@doc "验证邮箱验证码"
	@handler ValidateEmail
	post /validate-email (ValidateEmailRequest) returns (Response)

	@doc "注册"
	@handler Register
	post /register (RegisterRequest) returns (Response)

	@doc "登录"
	@handler Login
	post /login (LoginRequest) returns (Response)
}

@server (
	prefix:     /api/auth
	tags:       "认证模块"
	group:      auth
	middleware: AuthMiddleware,IPMiddleware
)
service xiaoan {
	@doc "生成邀请码"
	@handler GenerateInviteCode
	post /generate-invite-code (GenerateInviteCodeRequest) returns (Response)

	@doc "获取邀请码"
	@handler GetInviteCode
	post /get-invite-code (GetInviteCodeRequest) returns (Response)
}

// ---------------------------------------------------------------------------------------------------------------------
// ======================
// ========= qa =========
// ======================
// ---------------------------------------------------------------------------------------------------------------------
@server (
	prefix:     /api/qa
	tags:       "问答模块"
	group:      qa
	middleware: IPMiddleware
)
service xiaoan {
	@doc "获取答案"
	@handler GetAnswer
	post /answer (GetAnswerRequest) returns (Response)
}

// ---------------------------------------------------------------------------------------------------------------------
// ======================
// ======= content ======
// ======================
// ---------------------------------------------------------------------------------------------------------------------
@server (
	prefix:     /api/content
	tags:       "文件内容模块"
	group:      content
	middleware: AuthMiddleware,IPMiddleware
)
service xiaoan {
	@doc "添加文章"
	@handler AddArticle
	post /add-article (AddArticleRequest) returns (Response)

	@doc "修改文章"
	@handler ModifyArticle
	post /modify-article (ModifyArticleRequest) returns (Response)

	@doc "删除文章"
	@handler DeleteArticle
	delete /delete-article (DeleteArticleRequest) returns (Response)

	@doc "获取文章详细内容"
	@handler GetArticleContent
	get /get-article-content (GetArticleContentRequest) returns (Response)

	@doc "添加视频"
	@handler AddVideo
	post /add-video (AddVideoRequest) returns (Response)

	@doc "修改视频"
	@handler ModifyVideo
	post /modify-video (ModifyVideoRequest) returns (Response)

	@doc "删除视频"
	@handler DeleteVideo
	delete /delete-video (DeleteVideoRequest) returns (Response)

	@doc "获取视频详细内容"
	@handler GetVideoContent
	get /get-video-content (GetVideoContentRequest) returns (Response)

	@doc "添加播客"
	@handler AddPodcast
	post /add-podcast (AddPodcastRequest) returns (Response)

	@doc "修改播客"
	@handler ModifyPodcast
	post /modify-podcast (ModifyPodcastRequest) returns (Response)

	@doc "删除播客"
	@handler DeletePodcast
	delete /delete-podcast (DeletePodcastRequest) returns (Response)

	@doc "获取播客详细内容"
	@handler GetPodcastContent
	get /get-podcast-content (GetPodcastContentRequest) returns (Response)

	@doc "添加漫画"
	@handler AddComic
	post /add-comic (AddComicRequest) returns (Response)

	@doc "添加漫画章节"
	@handler AddComicChapter
	post /add-comic-chapter (AddComicChapterRequest) returns (Response)

	@doc "修改漫画"
	@handler ModifyComic
	post /modify-comic (ModifyComicRequest) returns (Response)

	@doc "修改漫画章节"
	@handler ModifyComicChapter
	post /modify-comic-chapter (ModifyComicChapterRequest) returns (Response)

	@doc "删除漫画"
	@handler DeleteComic
	delete /delete-comic (DeleteComicRequest) returns (Response)

	@doc "删除漫画章节"
	@handler DeleteComicChapter
	delete /delete-comic-chapter (DeleteComicChapterRequest) returns (Response)

	@doc "获取漫画"
	@handler GetComic
	get /get-comic (GetComicRequest) returns (Response)

	@doc "获取漫画章节"
	@handler GetComicChapter
	get /get-comic-chapter (GetComicChapterRequest) returns (Response)

	@doc "获取漫画页面"
	@handler GetComicPage
	get /get-comic-page (GetComicPageRequest) returns (Response)

	@doc "添加评论"
	@handler AddComment
	post /add-comment (AddCommentRequest) returns (Response)

	@doc "删除评论"
	@handler DeleteComment
	delete /delete-comment (DeleteCommentRequest) returns (Response)

	@doc "获取根评论"
	@handler GetRootComment
	get /get-root-comment (GetRootCommentRequest) returns (Response)

	@doc "获取子评论"
	@handler GetSubComment
	get /get-sub-comment (GetSubCommentRequest) returns (Response)

	@doc "点赞"
	@handler Like
	post /like (LikeRequest) returns (Response)

	@doc "取消点赞"
	@handler Unlike
	post /unlike (UnlikeRequest) returns (Response)

	@doc "收藏"
	@handler Collect
	post /collect (CollectRequest) returns (Response)

	@doc "取消收藏"
	@handler UnCollect
	post /uncollect (UnCollectRequest) returns (Response)
}

